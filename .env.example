# Campus Buddy Frontend Environment Variables
# Copy this file to .env and fill in your values

# Clerk Auth — get from https://dashboard.clerk.com
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Backend API URL — set this to your deployed AWS EC2 URL in production
# Example: VITE_API_URL=http://13.239.34.17:5000/api
VITE_API_URL=http://YOUR_AWS_PUBLIC_IP:5000/api
