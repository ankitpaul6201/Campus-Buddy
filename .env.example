# Campus Buddy Frontend Environment Variables
# Copy this file to .env and fill in your values

# Clerk Auth — get from https://dashboard.clerk.com
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Backend API URL — set this to your deployed Railway/Render URL in production
# Leave empty to use the default LAN IP (local dev) or localhost (browser)
VITE_API_URL=https://your-railway-url.up.railway.app/api
