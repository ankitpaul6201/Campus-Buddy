# ==========================================
# CAMPUS BUDDY — PRODUCTION CONFIGURATION
# ==========================================

NODE_ENV=production
PORT=5000

# MongoDB Atlas Connection String
# Ensure IP Access List in Atlas allows your production host IP or 0.0.0.0/0 with strict credentials
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.mongodb.net/campusbuddy?retryWrites=true&w=majority&appName=CampusBuddy

# Authentication & Session Security (Min 32 characters, random cryptographically secure string)
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string

# Approved Production CORS Origins (comma-separated, no trailing slashes)
# Defaults to Capacitor mobile schemes and local dev if omitted
ALLOWED_ORIGINS=https://campusbuddy.edu,https://campusbuddy.app,capacitor://localhost,https://localhost,http://localhost:5173

# Cloudinary Storage Credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Database Connection Pool (Atlas M0 default: 50, Atlas M10: 100)
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=10

# Anti-Sleep Keep-Alive Target URL (Set this to your live production domain e.g. on Render/Koyeb)
# Render also automatically provides RENDER_EXTERNAL_URL
BACKEND_URL=https://campus-buddy-backend-6hrs.onrender.com

# Email SMTP Delivery (e.g. Gmail with App Password)
# Used to deliver password reset codes directly to student email addresses
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_google_app_password
EMAIL_FROM=Campus Buddy <no-reply@campusbuddy.app>
